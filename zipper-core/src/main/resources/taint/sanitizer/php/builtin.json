    "vulnSanitizer": {
      "Xss": {
        "functions": [
          "htmlspecialchars",
          "htmlentities",
          "strip_tags",
          "rawurlencode",
          "urlencode"
        ],
        "methods": [],
        "regexes": [
          "/[<>]/",
          "/[^a-zA-Z_]/",
          "/^0-9a-zA-Z_/"
        ]
      },
      "CmdInjection": {
        "functions": [
          "escapeshellarg",
          "escapeshellcmd"
        ],
        "methods": [],
        "regexes": []
      },
      "SqlInjection": {
        "functions": [
          "addslashes",
          "mysqli_real_escape_string",
          "mysqli_escape_string",
          "mysql_escape_string"
        ],
        "methods": [
          {
            "typeName": "mysqli",
            "methodName": "escape_string"
          },
          {
            "typeName": "mysqli",
            "methodName": "real_escape_string"
          }
        ],
        "regexes": []
      },
      "FileInclusion": {
        "functions": [
          "dirname",
          "basename"
        ],
        "methods": [],
        "regexes": [
          "/[^a-zA-Z_]/",
          "/[^a-z0-9_]/"
        ]
      }
    }
