<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>bee.zipper</groupId>
    <artifactId>zipper</artifactId>
    <version>1.0</version>

    <packaging>pom</packaging>
    <modules>
        <module>zipper-util</module>
        <module>zipper-solver</module>
        <module>zipper-core</module>
        <module>zipper-scan</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <scala.version>3.4.2</scala.version>
        <jackson.version>2.16.1</jackson.version>
        <io.circe.version>0.14.9</io.circe.version>
        <tapir.version>1.11.20</tapir.version>
        <antlr4.version>4.13.1</antlr4.version>
        <langchain4j.version>1.0.1</langchain4j.version>
        <okhttp.version>4.12.0</okhttp.version>
        <joern.version>4.0.73</joern.version>
        <joern.antlr4.version>4.7.2</joern.antlr4.version>
        <joern.slf4j.version>2.0.7</joern.slf4j.version>
        <joern.log4j.version>2.22.0</joern.log4j.version>
    </properties>

    <repositories>
        <repository>
            <id>gradle</id>
            <name>Gradle Releases</name>
            <url>https://repo.gradle.org/gradle/libs-releases/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala3-library_3</artifactId>
            <version>${scala.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>3.1.8</version>
        </dependency>
        <dependency>
            <groupId>io.circe</groupId>
            <artifactId>circe-core_3</artifactId>
            <version>${io.circe.version}</version>
        </dependency>
        <dependency>
            <groupId>io.circe</groupId>
            <artifactId>circe-parser_3</artifactId>
            <version>${io.circe.version}</version>
        </dependency>
        <dependency>
            <groupId>io.circe</groupId>
            <artifactId>circe-generic_3</artifactId>
            <version>${io.circe.version}</version>
        </dependency>
        <dependency>
            <groupId>com.softwaremill.sttp.apispec</groupId>
            <artifactId>jsonschema-circe_3</artifactId>
            <version>0.11.7</version>
        </dependency>
        <dependency>
            <groupId>com.softwaremill.sttp.tapir</groupId>
            <artifactId>tapir-core_3</artifactId>
            <version>${tapir.version}</version>
        </dependency>
        <dependency>
            <groupId>com.softwaremill.sttp.tapir</groupId>
            <artifactId>tapir-apispec-docs_3</artifactId>
            <version>${tapir.version}</version>
        </dependency>
        <dependency>
            <groupId>com.softwaremill.sttp.tapir</groupId>
            <artifactId>tapir-json-circe_3</artifactId>
            <version>${tapir.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lihaoyi</groupId>
            <artifactId>os-lib_3</artifactId>
            <version>0.9.1</version>
        </dependency>
        <dependency>
            <groupId>org.scala-lang.modules</groupId>
            <artifactId>scala-collection-contrib_3</artifactId>
            <version>0.3.0</version>
        </dependency>
        <dependency>
            <groupId>org.scala-lang.modules</groupId>
            <artifactId>scala-parallel-collections_3</artifactId>
            <version>1.0.4</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-text</artifactId>
            <version>1.10.0</version>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>32.1.3-jre</version>
        </dependency>
        <dependency>
            <groupId>com.github.scopt</groupId>
            <artifactId>scopt_3</artifactId>
            <version>4.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.scalatest</groupId>
            <artifactId>scalatest_3</artifactId>
            <version>3.2.16</version>
            <scope>test</scope>
        </dependency>

        <!-- see joern build.sbt -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${joern.slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>${joern.log4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${joern.log4j.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
                <version>4.8.1</version>
                <configuration>
                    <recompileMode>incremental</recompileMode>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                            <goal>testCompile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.scalatest</groupId>
                <artifactId>scalatest-maven-plugin</artifactId>
                <version>2.2.0</version>
                <configuration>
                    <reportsDirectory>${project.build.directory}/reports</reportsDirectory>
                    <filereports>TestSuite.txt</filereports>
                </configuration>
                <executions>
                    <execution>
                        <id>test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>2.43.0</version>
                <configuration>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <googleJavaFormat>
                            <version>1.22.0</version>
                            <style>AOSP</style>
                            <reflowLongStrings>true</reflowLongStrings>
                        </googleJavaFormat>
                    </java>
                    <scala>
                        <includes>
                            <include>src/main/**/*.scala</include>
                            <include>src/test/**/*.scala</include>
                        </includes>
                        <scalafmt>
                            <version>3.8.1</version>
                            <file>${maven.multiModuleProjectDirectory}/.scalafmt.conf</file>
                        </scalafmt>
                    </scala>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>apply</goal>
                        </goals>
                        <phase>compile</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>